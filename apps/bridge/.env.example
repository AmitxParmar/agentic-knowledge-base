# DeviceHub bridge — copy to apps/bridge/.env for local development.
# Never commit real credentials; .env is already gitignored.

# Identity stamped into every payload and topic. Seeded by migrations/0002_seed.sql.
HUB_DEVICE_ID=0192f3c4-1a2b-7c3d-8e4f-5a6b7c8d9e0f

# Serial port carrying firmware/telemetry output.
BRIDGE_SERIAL_PORT=/dev/ttyACM0
BRIDGE_BAUD=115200
BRIDGE_FW_VERSION=0.1.0

# How many events to hold while the broker is unreachable.
BRIDGE_BUFFER_CAPACITY=1000

MQTT_HOST=localhost
MQTT_PORT=1883
# Cloud brokers are TLS-only: set true and use port 8883.
MQTT_TLS=false
# Defaults to d_<HUB_DEVICE_ID>, matching deploy/mosquitto/acl.
# MQTT_USERNAME=d_0192f3c4-1a2b-7c3d-8e4f-5a6b7c8d9e0f
MQTT_PASSWORD=change-me
MQTT_TOPIC_PREFIX=dh/v1
