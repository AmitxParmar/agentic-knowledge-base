# Knowledge Base API (browser-visible)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# DeviceHub hub (`apps/hub`) — server-only.
# Never prefix these with NEXT_PUBLIC_: the bearer token stays on the server
# and every dashboard request is proxied through app/api/devicehub/*.
HUB_API_URL=http://localhost:8080
HUB_API_TOKEN=change-me
