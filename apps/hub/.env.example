# DeviceHub hub — copy to apps/hub/.env for local development.
# Never commit real credentials; .env is already gitignored.

# Separate database from the Knowledge Base. On Neon use the *pooled* URL,
# which already carries `sslmode=require`.
HUB_DATABASE_URL=postgres://devicehub:devicehub@localhost:5432/devicehub

# Demo-only bearer token for /v1/*. Not the SECURITY.md auth design.
HUB_API_TOKEN=dev-token-change-me

HUB_BIND_HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=http://localhost:3000

DB_MAX_CONNECTIONS=5

MQTT_HOST=localhost
MQTT_PORT=1883
# Cloud brokers are TLS-only: set true and use port 8883.
MQTT_TLS=false
MQTT_USERNAME=hub
MQTT_PASSWORD=change-me
MQTT_TOPIC_PREFIX=dh/v1

HEARTBEAT_TIMEOUT_SECS=15
TELEMETRY_RETENTION_HOURS=48
